# Copy this file to secrets.toml (same folder) and fill in your values. secrets.toml is not in git.
# Only lab 060 (MinIO -> SQL Server) needs it; every other lab runs without this file.
# Replace every <...> placeholder. Lab 060 stops and lists the settings that are still missing.

# ---------- MinIO (on-prem): where lab 060 reads the files ----------
[sources.filesystem]
bucket_url = "s3://<bucket>/<folder>"         # the bucket and folder that hold the CSV files
# MinIO over https with a certificate from your company's own CA: point to that CA as a PEM file.
# client_kwargs = { verify = "C:/certs/company-ca.pem" }

[sources.filesystem.credentials]
aws_access_key_id = "<access-key>"            # a MinIO access key with read access to the bucket
aws_secret_access_key = "<secret-key>"        # the secret that belongs to the access key
endpoint_url = "https://<minio-host>:9000"    # MinIO's S3 API address (ask IT), not the web console (often port 9001)
# region_name = "us-east-1"                   # only if your MinIO is set up with a region

# ---------- SQL Server: where lab 060 loads the data ----------
[destination.mssql.credentials]
host = "<sql-server-host>"                    # server name or IP address
port = 1433                                   # the default SQL Server port
database = "<database>"                       # the database to load into; dlt creates its own schema there
username = "<sql-login>"                      # a SQL Server login: dlt signs in with username + password,
password = "<password>"                       #   not with Windows authentication
driver = "ODBC Driver 18 for SQL Server"      # optional: dlt picks an installed driver if you leave it out
# query = { TrustServerCertificate = "yes" }  # only for a server with a self-signed certificate (test setups)
